# Auvric Scout — server-side environment variables
# Copy this file to `.env` (which is git-ignored) and fill in real values.
# NONE of these are exposed to the frontend. Do not prefix any of them with VITE_.

# Anthropic API key — powers AI outreach draft generation.
# If unset, outreach generation falls back to the deterministic email builder
# (a friendly "not configured" note is added to the draft warnings). Email drafting
# always works with or without this key.
ANTHROPIC_API_KEY=

# Optional: model used for outreach generation (defaults to claude-opus-4-8).
# OUTREACH_MODEL=claude-opus-4-8

# Google Places API (New) key — powers Lead Discovery (Text Search) and the optional
# Business Profile Research "fetch reviews & hours" details pass.
# If unset, /api/discover-leads and /api/profile-details return HTTP 503
# "not configured yet"; basic no-website Profile Research still works from saved data.
# This key is read server-side only and is never returned to the browser.
GOOGLE_PLACES_API_KEY=

# ---- Optional (safe defaults if unset) ----
# NODE_ENV=production          # enables production error handling (generic errors)
# JSON_BODY_LIMIT=32kb         # max JSON request body size
# RATE_LIMIT_AUDIT=30          # /api/audit requests per minute
# RATE_LIMIT_BULK=10           # /api/bulk-audit requests per minute
# RATE_LIMIT_DISCOVER=20       # /api/discover-leads requests per minute
# RATE_LIMIT_OUTREACH=15       # /api/generate-outreach requests per minute
# RATE_LIMIT_PROFILE=15        # /api/profile-details requests per minute (billable Google)

# LOCAL TESTING ONLY — relaxes the SSRF private-IP block so audits can hit
# 127.0.0.1 fixtures. NEVER set this in production.
# AUDIT_ALLOW_PRIVATE_HOSTS=true
